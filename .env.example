# --- Senaryo (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Seslendirme (ElevenLabs) ---
# Ücretli plan gerekli: ücretsiz planda ticari kullanım lisansı yok.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (kalite) | eleven_turbo_v2_5 (hız/ucuz)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Görsel üretimi ---
# placeholder = API'siz çalışır, gradient SVG üretir (pipeline testi için)
# replicate   = Flux ile gerçek görsel
IMAGE_PROVIDER=placeholder
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- İçerik dili: en (yüksek RPM) | tr ---
CONTENT_LANG=en

# --- Opsiyonel arka plan müziği ---
# public/music/ içine koy, sadece dosya adını yaz. Boşsa müzik eklenmez.
# YALNIZCA lisanslı / YouTube Audio Library müziği kullan.
MUSIC_FILE=
